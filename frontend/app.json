{
  "expo": {
    "name": "Mausam",
    "slug": "mausam",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mausam",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#EBF4FF"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Mausam uses your location to provide personalized weather intelligence and local forecasts."
      },
      "bundleIdentifier": "com.anonymous.mausam"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EBF4FF"
      },
      "package": "com.anonymous.mausam",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Mausam needs access to your location to provide accurate local weather."
        }
      ]
    ]
  }
}
