# Server Port & Environment
PORT=3000
NODE_ENV=development

# MongoDB (use a real value only in your untracked server/.env)
MONGODB_URI=
MONGODB_DB_NAME=personalized_mausam

# Firebase Admin SDK (same Firebase project as the mobile app; never commit credentials)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Keep false outside a narrowly scoped local test environment.
ALLOW_DEV_MOCK_AUTH=false

IMD_API_BASE_URL=
IMD_API_KEY=
